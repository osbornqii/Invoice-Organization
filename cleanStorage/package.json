{
  "name": "cleanStorage",
  "version": "1.0.0",
  "description": "定时清理云存储过期文件",
  "main": "index.js",
  "dependencies": {
    "wx-server-sdk": "~2.6.3"
  },
  "cloudfunction-config": {
    "memorySize": 256,
    "timeout": 60,
    "triggers": [
      {
        "name": "dailyClean",
        "type": "timer",
        "config": "0 0 2 * * * *"
      }
    ]
  }
}
